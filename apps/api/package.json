{
  "name": "@veritine/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "db:generate": "prisma generate --schema ../../database/schema.prisma",
    "db:migrate": "prisma migrate dev --schema ../../database/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema ../../database/schema.prisma",
    "db:seed": "tsx ../../database/seeds/seed.ts",
    "db:studio": "prisma studio --schema ../../database/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.6",
    "@nestjs/core": "^10.4.6",
    "@nestjs/platform-express": "^10.4.6",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/throttler": "^6.2.1",
    "@prisma/client": "^5.20.0",
    "@veritine/contract-client": "workspace:*",
    "@veritine/shared-config": "workspace:*",
    "@veritine/shared-types": "workspace:*",
    "@veritine/validation": "workspace:*",
    "cookie-parser": "^1.4.7",
    "ethers": "^6.13.4",
    "express": "^4.21.1",
    "genlayer-js": "^1.2.0",
    "helmet": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.7.5",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
